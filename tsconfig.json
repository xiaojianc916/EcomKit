{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "test/**/*.ts",
    "postcss/**/*.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "wxt.config.ts"
  ],
  "exclude": ["node_modules", ".output", ".wxt/types", "src/**/__fixtures__/**", "doctor.config.ts"]
}
