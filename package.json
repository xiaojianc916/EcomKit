{
  "name": "ecbox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "电商素材工具箱 — 拼多多、抖音商品素材归档下载",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "node scripts/build.ts",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:registries": "node scripts/gen-registries.ts",
    "gen:key": "node scripts/gen-key.ts",
    "release": "node scripts/release.ts",
    "check": "pnpm lint && pnpm compile && pnpm depcruise && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "4.0.1",
    "idb": "8.0.4",
    "lucide-react": "1.69.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "0.3.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "dependency-cruiser": "18.7.2",
    "happy-dom": "21.0.4",
    "jszip": "3.10.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}